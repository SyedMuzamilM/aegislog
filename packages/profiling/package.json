{
  "name": "@aegislog/profiling",
  "version": "0.3.1",
  "description": "Opt-in request waterfalls and OpenTelemetry instrumentation for AegisLog.",
  "homepage": "https://github.com/syedmuzamilm/aegislog#readme",
  "license": "MIT",
  "author": "Syed Muzamil <syedmuzamilm@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syedmuzamilm/aegislog.git",
    "directory": "packages/profiling"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "express": [
        "dist/express.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/express.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts src/express.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.64.0",
    "@opentelemetry/instrumentation-mongodb": "^0.76.0",
    "@opentelemetry/instrumentation-mongoose": "^0.69.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "aegislog": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "mongodb": "7.1.0",
    "mongodb-memory-server": "^11.2.0",
    "mongoose": "9.1.4"
  },
  "engines": {
    "node": ">=18.19.0"
  }
}
