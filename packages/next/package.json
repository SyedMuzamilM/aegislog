{
  "name": "@aegislog/next",
  "version": "0.2.1",
  "description": "Next.js App Router and Server Actions adapter for AegisLog.",
  "homepage": "https://github.com/syedmuzamilm/aegislog#readme",
  "license": "MIT",
  "author": "Syed Muzamil <syedmuzamilm@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syedmuzamilm/aegislog.git",
    "directory": "packages/next"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aegislog": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=13.0.0 || >=14.0.0 || >=15.0.0"
  }
}
