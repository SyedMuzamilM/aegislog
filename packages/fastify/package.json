{
  "name": "@aegislog/fastify",
  "version": "0.1.0",
  "description": "Fastify plugin adapter for AegisLog.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aegislog": "workspace:*",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "fastify": "^5.2.1"
  },
  "peerDependencies": {
    "fastify": ">=4.0.0 || >=5.0.0"
  }
}
