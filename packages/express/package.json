{
  "name": "@aegislog/express",
  "version": "0.2.0",
  "description": "Express middleware adapter for AegisLog.",
  "homepage": "https://github.com/syedmuzamilm/aegislog#readme",
  "license": "MIT",
  "author": "Syed Muzamil <syedmuzamilm@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syedmuzamilm/aegislog.git",
    "directory": "packages/express"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aegislog": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^4.21.2"
  },
  "peerDependencies": {
    "express": ">=4.18.0 || >=5.0.0"
  }
}
