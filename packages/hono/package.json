{
  "name": "@aegislog/hono",
  "version": "0.1.0",
  "description": "Hono and Cloudflare Workers middleware adapter for AegisLog.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aegislog": "workspace:*"
  },
  "peerDependencies": {
    "hono": ">=3.0.0 || >=4.0.0"
  },
  "devDependencies": {
    "hono": "^4.7.2"
  },
  "license": "MIT"
}
